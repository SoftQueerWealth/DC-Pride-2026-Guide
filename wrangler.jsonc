{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sqw-events-guide-staging",
  "compatibility_date": "2026-05-07",
  "main": "worker.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": ["nodejs_compat"],

  "env": {
    "staging": {
      "name": "sqw-events-guide-staging"
    }
  }
}
