{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sqw-events-guide-staging",
  "compatibility_date": "2026-05-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist"
  },
  "compatibility_flags": ["nodejs_compat"],

  "env": {
    "staging": {
      "name": "sqw-events-guide-staging"
    }
  }
}
